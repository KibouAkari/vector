# Supply private values through the deployment's secret mechanism.
DATABASE_URL=
VECTOR_SECRET=
FILE_ENCRYPTION_KEY=
FILE_STORAGE_PATH=/data/vector-files
COOKIE_SECURE=true

# Fast, deterministic local review. Optional NER is explicit and can be slower.
VECTOR_PRIVACY_REVIEW=1
VECTOR_PRIVACY_DETECTOR=rules
# VECTOR_PRIVACY_DETECTOR=ner
# Retain the existing private NER service URL/token configuration for that mode.

# Local-only chat is enabled separately from privacy review.
VECTOR_LOCAL_WORKERS=0

# Inference admission ceilings; currency conversion is operator configured.
DAILY_HARD_LIMIT_CHF=5
MONTHLY_HARD_LIMIT_CHF=25
USD_TO_CHF_RATE=0.85

# Empty means public targets only. Private IPv4 requires an exact CIDR allowlist.
# Configure only networks the operator is authorized to assess.
VECTOR_SECURITY_PRIVATE_CIDRS=
# Optional; only used when the asset explicitly opts in to advisory lookups.
NVD_API_KEY=

# The existing background worker must call /api/internal/jobs/run-one using
# its existing secret. It runs queued scans when no chat job is available.
# Provider credentials and per-model prices are managed in Models & API Keys.

# Operations centre. Credentials/snapshots and Brain body use FILE_ENCRYPTION_KEY.
# Exact RFC1918 destinations permitted for tool connectors (IPv4 CIDRs only).
VECTOR_CONNECTOR_PRIVATE_CIDRS=
# Keep false; only allow cleartext HTTP to explicit private CIDRs if necessary.
VECTOR_CONNECTOR_ALLOW_PRIVATE_HTTP=false
# Random >=32-character key, shared only with your read-only traffic collector.
# Traffic ingestion is disabled without it. Do not commit the populated value.
VECTOR_TRAFFIC_INGEST_TOKEN=
