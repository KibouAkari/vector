[Unit]
Description=Vector local connection metadata and host metrics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vector-observatory
Group=vector-observatory
SupplementaryGroups=adm
LoadCredential=ingest.key:/etc/vector-observatory/ingest.key
ExecStart=/usr/bin/python3 /opt/vector-observatory/collector.py --config /etc/vector-observatory/config.json --key-file %d/ingest.key
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
CPUQuota=5%
MemoryMax=160M
TasksMax=32
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
